#!/bin/bash

function show_help() {
    cat <<EOF
Usage: $0 [OPTIONS]

Options:
    -s, --enable-spdk          Enable SPDK
        --spdk-interrupt-mode  Enable SPDK interrupt mode
        --spdk-memory-size     SPDK memory size in MB
        --spdk-cpumask         SPDK CPU mask. The first (lowest) core runs the admin reactor only,
                               the other cores run the pollers (a single-core mask shares the core)
        --spdk-iobuf-large-pool-size  SPDK iobuf large_pool_count (0 = SPDK default)
        --spdk-iobuf-small-pool-size  SPDK iobuf small_pool_count (0 = SPDK default)
        --spdk-no-hugepage     Disable SPDK hugepage usage
    -l, --spdk-log             SPDK log level
    -h, --help                 Show this help message and exit
EOF
    exit 0
}

function bind_dev() {
    mount --rbind /host/dev /dev
}

function bind_sys() {
    mount --rbind /host/sys /sys
}

function bind_lib_modules() {
    mount --rbind /host/lib/modules /lib/modules
}

function enable_tgtd() {
    echo "Enabling tgtd"
    tgtd -f 2>&1 | tee /var/log/tgtd.log &
}

function generate_nvme_hostid_and_hostnqn() {
    mkdir -p /etc/nvme

    local hostnqn=$(nvme gen-hostnqn)
    # hostnqn is generated from /sys/class/dmi/id/product_uuid according to the implementation of libnvme
    echo "$hostnqn" > /etc/nvme/hostnqn
    # Always generate the same hostid for the same hostnqn
    cat /sys/class/dmi/id/product_uuid > /etc/nvme/hostid
}

# split_spdk_cpumask prints "<main core id> <poller cpumask>" for the given SPDK CPU mask, either
# hexadecimal with or without the 0x prefix (e.g. 0x3) or a bracketed CPU list (e.g. [2-3] or [0,2,4-6]).
# The main core is the lowest core of the mask. It hosts the SPDK admin (main) reactor, which runs the
# app thread that serves the JSON-RPC and management work. The poller cpumask holds every other core
# of the mask and is empty when the mask has a single core. Fails if the mask cannot be parsed.
function split_spdk_cpumask() {
    python3 -c '
import sys
s = sys.argv[1].strip()
if s.startswith("["):
    mask = 0
    for part in s.strip("[]").split(","):
        lo, _, hi = part.partition("-")
        for core in range(int(lo), int(hi or lo) + 1):
            mask |= 1 << core
else:
    mask = int(s, 16)
if mask <= 0:
    sys.exit(1)
low = mask & -mask
rest = mask & ~low
print(low.bit_length() - 1, "0x{:x}".format(rest) if rest else "")
' "$1" 2>/dev/null
}

# prepare_spdk_startup_config writes an SPDK startup JSON config. Everything in it can ONLY be set
# during spdk_tgt startup, which is why it is fed via --json instead of a runtime RPC:
#   - iobuf_set_options sets the iobuf buffer pool sizes (large_pool_count / small_pool_count). The
#     NVMe-oF TCP transport is created later at runtime by the engine and draws from these pools.
#   - nvmf_set_config sets poll_groups_mask, the cores that get an NVMe-oF target poll group. Without
#     it SPDK creates one on every core, including the one that runs the admin reactor.
#   $1: output config path
#   $2: NVMe-oF poll groups cpumask, empty to keep the SPDK default
#   $3..: iobuf_set_options params, each a JSON member (e.g. '"large_pool_count": 4096')
function prepare_spdk_startup_config() {
    local config_path="$1"
    local poll_groups_mask="$2"
    shift 2
    local iobuf_params
    iobuf_params=$(IFS=,; echo "$*")

    local body=""
    if [ -n "$iobuf_params" ]; then
        body+="    {
      \"subsystem\": \"iobuf\",
      \"config\": [
        {
          \"method\": \"iobuf_set_options\",
          \"params\": { ${iobuf_params} }
        }
      ]
    }"
    fi
    if [ -n "$poll_groups_mask" ]; then
        [ -n "$body" ] && body+=$',\n'
        body+="    {
      \"subsystem\": \"nvmf\",
      \"config\": [
        {
          \"method\": \"nvmf_set_config\",
          \"params\": { \"poll_groups_mask\": \"${poll_groups_mask}\" }
        }
      ]
    }"
    fi

    cat > "$config_path" <<EOF
{
  "subsystems": [
${body}
  ]
}
EOF
    echo "Generated SPDK startup config at ${config_path}:"
    cat "$config_path"
}

function enable_spdk_tgt() {
    local options=("$@")
    echo "Enabling spdk_tgt with options: ${options[*]}"
    spdk_tgt "${options[@]}" 2>&1 | tee -a /log/spdk_tgt.log &

    timeout=120  # Timeout in seconds
    interval=1  # Interval in seconds
    elapsed_time=0

    while [ $elapsed_time -lt $timeout ]; do
        if [ -S "/var/tmp/spdk.sock" ]; then
            echo "Socket file '/var/tmp/spdk.sock' found after $elapsed_time seconds."
            return 0  # Exit successfully if the file exists
        fi

        sleep $interval
        elapsed_time=$((elapsed_time + interval))
    done

    echo "Timeout reached. Socket file '/var/tmp/spdk.sock' not found."
    return 1
}

enable_spdk=0
spdk_cpumask=""
iobuf_large_pool_size=0
iobuf_small_pool_size=0
spdk_options=()
instance_manager_options=()

while [[ $# -gt 0 ]]; do
    opt="$1"
    case $opt in
        -s|--enable-spdk)
            enable_spdk=1
            ;;
        -m|--spdk-cpumask)
            spdk_cpumask="$2"
            spdk_options+=("-m" "$2")
            shift
            ;;
        -s|--spdk-memory-size)
            spdk_options+=("--mem-size" "$2")
            shift
            ;;
        --spdk-iobuf-large-pool-size)
            iobuf_large_pool_size="$2"
            shift
            ;;
        --spdk-iobuf-small-pool-size)
            iobuf_small_pool_size="$2"
            shift
            ;;
        -g|--spdk-no-hugepage)
            spdk_options+=("--no-huge")
            ;;
        -l|--spdk-log)
            spdk_options+=("-L" "$2")
            shift
            ;;
        --spdk-interrupt-mode)
            spdk_options+=("--interrupt-mode")
            ;;
        -h|--help)
            show_help
            ;;
        *)
            instance_manager_options+=("$1")
            ;;
    esac
    shift
done

#### Main ####

if [ "$enable_spdk" -eq 1 ]; then
    mkdir -p /log
    touch /log/instance-manager-${DATA_ENGINE}.log
    touch /log/spdk_tgt.log
fi

bind_dev
bind_sys
bind_lib_modules
[ "$enable_spdk" -eq 0 ] && enable_tgtd
[ "$enable_spdk" -eq 1 ] && generate_nvme_hostid_and_hostnqn

# Keep the SPDK admin (main) reactor on the first core of the CPU mask and use the other cores for
# everything else (NVMe-oF target poll groups here, the ublk target in longhorn-spdk-engine, which
# reads SPDK_POLLER_CPUMASK). A single-core mask leaves nothing to separate, so SPDK keeps its default.
spdk_poller_cpumask=""
if [ "$enable_spdk" -eq 1 ] && [ -n "$spdk_cpumask" ]; then
    if cpumask_split=$(split_spdk_cpumask "$spdk_cpumask"); then
        read -r spdk_main_core spdk_poller_cpumask <<< "$cpumask_split"
        spdk_options+=("--main-core" "$spdk_main_core")
        if [ -n "$spdk_poller_cpumask" ]; then
            export SPDK_POLLER_CPUMASK="$spdk_poller_cpumask"
            echo "SPDK admin reactor on core ${spdk_main_core}, pollers on cpumask ${spdk_poller_cpumask}"
        else
            echo "SPDK cpumask ${spdk_cpumask} has a single core, the admin reactor and the pollers share core ${spdk_main_core}"
        fi
    else
        echo "WARNING: Failed to parse SPDK cpumask ${spdk_cpumask}, not separating the admin reactor from the pollers"
    fi
fi

# Feed pool sizes set above their SPDK default (large 1024, small 8192) and the poller cpumask to
# spdk_tgt via a startup JSON config; with neither nothing is generated and the launch is unchanged.
iobuf_params=()
[ "$iobuf_large_pool_size" -gt 1024 ] && iobuf_params+=("\"large_pool_count\": ${iobuf_large_pool_size}")
[ "$iobuf_small_pool_size" -gt 8192 ] && iobuf_params+=("\"small_pool_count\": ${iobuf_small_pool_size}")
if [ "$enable_spdk" -eq 1 ] && { [ "${#iobuf_params[@]}" -gt 0 ] || [ -n "$spdk_poller_cpumask" ]; }; then
    prepare_spdk_startup_config "/tmp/spdk-startup.json" "$spdk_poller_cpumask" "${iobuf_params[@]}"
    spdk_options+=("--json" "/tmp/spdk-startup.json")
fi

[ "$enable_spdk" -eq 1 ] && enable_spdk_tgt "${spdk_options[@]}"

if [ "$enable_spdk" -eq 1 ]; then
    exec-logrotate
    exec longhorn-instance-manager "${instance_manager_options[@]}" 2>&1 | tee -a /log/instance-manager-${DATA_ENGINE}.log
else
    exec longhorn-instance-manager "${instance_manager_options[@]}"
fi
